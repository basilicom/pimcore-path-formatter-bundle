parameters:
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - identifier: missingType.iterableValue
    # Symfony 6.4 (Pimcore 11) types the config builder chain too loosely
    -
      identifier: method.notFound
      path: src/DependencyInjection/ConfigDefinition.php
  level: 6
  paths:
    - src
  bootstrapFiles:
    - phpstan-bootstrap.php
